# Скопируй в .env и поменяй под себя
DATABASE_URL=postgres://omni:omni@localhost:5432/omniroute
# Для автотестов — отдельная база, тесты её чистят
TEST_DATABASE_URL=postgres://omni:omni@localhost:5432/omniroute_test
PORT=3000
# В проде true: cookie уходит только по https
COOKIE_SECURE=false
# Node.js слушает только саму машину, снаружи к нему ходят через Nginx
HOST=127.0.0.1
# Каким прокси верить в X-Forwarded-For: loopback = только Nginx на этой же машине
TRUST_PROXY=loopback
