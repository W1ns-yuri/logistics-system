# Домен сайта. До запуска в DNS домена должна быть A-запись на IP сервера
DOMAIN=app.example.com
# Почта для Let's Encrypt (придут письма, если с сертификатом что-то не так)
ACME_EMAIL=admin@example.com
# Пароль базы: длинный и случайный, например  openssl rand -base64 32
POSTGRES_PASSWORD=
# Сколько дней хранить ночные бэкапы
BACKUP_KEEP_DAYS=14
