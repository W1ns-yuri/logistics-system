# Caddy сам получает и продлевает HTTPS-сертификат Let's Encrypt для домена из DOMAIN
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# API: на сервер Node.js. Host и X-Forwarded-* Caddy передаёт сам — по ним сервер проверяет Origin и IP
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3000
	}

	# Файлы сборки с хэшем в имени не меняются — браузер держит их год
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Остальное — страницы приложения (index.html не кэшируем, чтобы обновления доходили сразу)
	handle {
		root * /srv
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
